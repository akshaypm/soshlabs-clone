# Names and local defaults only. This repository is public.
# Copy to api/.env (gitignored). Never commit real keys.
# Never use keys from the live soshlabs.ai bundle. This API does not call api.soshlabs.ai.

# Local docker-compose Postgres. Not a production credential.
DATABASE_URL=postgresql://sosh:sosh@localhost:5432/sosh

# Optional. Defaults: PORT=4000, HOST=0.0.0.0, LOG_LEVEL=info, NODE_ENV=development.
PORT=
HOST=
LOG_LEVEL=
NODE_ENV=

# Clerk session JWT verification. Leave unset in tests (the suite injects a fake verifier).
# Use the owner's Clerk *test* instance. CLERK_JWT_KEY is the PEM public key (networkless verify).
# CLERK_AUTHORIZED_PARTIES is an optional comma-separated azp allowlist (for example http://localhost:3000).
CLERK_SECRET_KEY=
CLERK_JWT_KEY=
CLERK_AUTHORIZED_PARTIES=

# When ANTHROPIC_API_KEY is unset, POST /api/v1/ai/ping uses FakeAiProvider.
# When the key is set, ANTHROPIC_MODEL is required (for example claude-sonnet-4-5).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Stripe and S3 are not read yet. Add them with billing and media upload, not before.
