// Core domain for the Sosh API. Brand DNA, generation, posts, social
// accounts, and billing build on these tables. Keep the schema lean.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MembershipRole {
  owner
  admin
  member
}

/// Product statuses. `pending_approval` is stored as `pending-approval`.
enum PostStatus {
  draft
  ready
  scheduled
  published
  pending_approval @map("pending-approval")
}

enum ContentType {
  post
  reel
  story
  carousel
  video
  article
}

enum SocialPlatform {
  instagram
  facebook
  linkedin
  x
  tiktok
  youtube
  threads
  pinterest
  bluesky
  reddit
}

model User {
  id          String   @id @default(cuid())
  clerkUserId String   @unique
  email       String   @unique
  name        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships Membership[]
}

/// A Brand Space is the org the client sends as `x-org-id`.
model BrandSpace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships    Membership[]
  brandDna       BrandDna?
  posts          Post[]
  campaigns      Campaign[]
  socialAccounts SocialAccount[]
  mediaAssets    MediaAsset[]
}

model Membership {
  id           String         @id @default(cuid())
  role         MembershipRole
  userId       String
  brandSpaceId String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  brandSpace BrandSpace @relation(fields: [brandSpaceId], references: [id], onDelete: Cascade)

  @@unique([userId, brandSpaceId])
  @@index([brandSpaceId])
}

model BrandDna {
  id           String   @id @default(cuid())
  brandSpaceId String   @unique
  summary      String   @db.Text
  voice        String?  @db.Text
  audience     String?  @db.Text
  goals        String?  @db.Text
  websiteUrl   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  brandSpace BrandSpace @relation(fields: [brandSpaceId], references: [id], onDelete: Cascade)
}

model Campaign {
  id           String    @id @default(cuid())
  brandSpaceId String
  name         String
  goal         String?   @db.Text
  startsAt     DateTime?
  endsAt       DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  brandSpace BrandSpace @relation(fields: [brandSpaceId], references: [id], onDelete: Cascade)
  posts      Post[]

  @@index([brandSpaceId])
}

model Post {
  id           String         @id @default(cuid())
  brandSpaceId String
  campaignId   String?
  contentType  ContentType
  platform     SocialPlatform
  status       PostStatus     @default(draft)
  body         String         @db.Text
  scheduledAt  DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  brandSpace BrandSpace @relation(fields: [brandSpaceId], references: [id], onDelete: Cascade)
  campaign   Campaign?  @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([brandSpaceId, status])
  @@index([brandSpaceId, scheduledAt])
  @@index([campaignId])
}

model SocialAccount {
  id                String         @id @default(cuid())
  brandSpaceId      String
  platform          SocialPlatform
  externalAccountId String
  displayName       String?
  /// Ciphertext placeholder. Social connect will encrypt the provider token.
  /// Do not write a raw access token into this column.
  tokenCiphertext   String?        @db.Text
  tokenExpiresAt    DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  brandSpace BrandSpace @relation(fields: [brandSpaceId], references: [id], onDelete: Cascade)

  @@unique([brandSpaceId, platform, externalAccountId])
}

model MediaAsset {
  id           String   @id @default(cuid())
  brandSpaceId String
  storageKey   String
  fileName     String
  mimeType     String
  byteSize     Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  brandSpace BrandSpace @relation(fields: [brandSpaceId], references: [id], onDelete: Cascade)

  @@unique([brandSpaceId, storageKey])
}
